# Application Configuration
APP_NAME=AI Store Intelligence System
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Database Configuration
DATABASE_URL=postgresql://store_user:store_password@localhost:5432/store_intelligence
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRY=3600

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# ML Model Configuration
YOLO_MODEL_PATH=app/ml/models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.45

# Video Processing Configuration
FRAME_EXTRACTION_FPS=30
VIDEO_RESOLUTION_WIDTH=1920
VIDEO_RESOLUTION_HEIGHT=1080

# Event Configuration
CROWD_DETECTION_THRESHOLD=5
LOITERING_DURATION_SECONDS=30
QUEUE_FORMATION_THRESHOLD=8

# Storage Configuration
STORAGE_PATH=./storage
VIDEO_STORAGE_PATH=./storage/videos
MODELS_STORAGE_PATH=./storage/models

# Feature Flags
ENABLE_GPU=true
ENABLE_WEBSOCKET=true
ENABLE_ANALYTICS_CACHE=true

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_FROM_NUMBER=+1234567890
